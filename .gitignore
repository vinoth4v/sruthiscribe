# Decoded audio and cached pitch tracks — regenerable, and large.
tools/data/cache/

# Build outputs. Every one of these is rebuilt from its source by the tool that
# wrote it, so the repo keeps the builders rather than what they produced.
tools/data/*.json
tools/data/*.sql

# ...with one exception. The accuracy figures the front page prints are checked
# against this file by test/published_test.js, so it is evidence for a public
# claim rather than a regenerable artefact -- and it cannot be regenerated
# without the Sanidha dataset, which is not public. 65 kB.
!tools/data/sanidha.json

# Cached Wikipedia wikitext. The builders re-fetch it from the API on demand;
# committing it would freeze a snapshot of pages that keep being edited.
tools/data/wiki/

# The CompMusic Carnatic Varnam Dataset, fetched by tools/fetch-varnams.py.
# CC BY-NC-ND 4.0 — redistributing it from here is what the ND term rules out,
# and the fetcher pulls what is needed out of Zenodo in a couple of seconds.
tools/data/varnams/

.DS_Store
__pycache__/

# SSP volumes, fetched by tools/fetch-ssp.py. The 1904 text is public domain;
# the English-edition typesetting is not ours to redistribute.
tools/data/ssp/

# DevTools "Copy as cURL" dumps for the Sanidha portal. These carry a live
# session cookie -- they are credentials, not configuration.
*.curl
tools/data/*.curl

# Installed by "npm install" for the jsdom-based DOM tests.
node_modules/
